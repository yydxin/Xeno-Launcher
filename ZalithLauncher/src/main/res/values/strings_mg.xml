    <!-- 状态检查发现的问题 -->
    <string name="mg_issue_library_missing">问题：APK 中没有 libmobileglues.so，请确认已把预编译库放入 jniLibs/arm64-v8a。</string>
    <string name="mg_issue_abi_unsupported">问题：当前设备不支持 arm64-v8a，MobileGlues 仅有 arm64-v8a 预编译库。</string>
    <string name="mg_issue_gles_unknown">问题：无法读取系统 GLES 版本。</string>
    <string name="mg_issue_gles_low">问题：系统 GLES 版本低于 3.0，MobileGlues 无法工作。</string>
    <string name="mg_issue_config_missing">提示：config.json 尚未生成，启动游戏时会自动创建。</string>
    <string name="mg_issue_config_invalid">问题：config.json 不是合法配置，启动时会备份为 config.json.broken 并重建。</string>
    <string name="mg_issue_log_missing">提示：latest.log 尚未生成，用 MobileGlues 启动一次游戏后即可查看。</string>
    <string name="mg_issue_inspection_failed">问题：状态检查失败，请重新打开此页面或查看启动器日志。</string>

    <!-- ANGLE 后端 -->
    <string name="mg_enable_angle_title">ANGLE 后端</string>
    <string name="mg_enable_angle_summary">控制 MobileGlues 是否使用 ANGLE 提供的 GLES 实现；部分驱动上可改善兼容性，也可能降低性能。</string>
    <string name="mg_angle_mode_disable_if_possible">尽可能禁用（DisableIfPossible，默认）</string>
    <string name="mg_angle_mode_enable_if_possible">尽可能启用（EnableIfPossible）</string>
    <string name="mg_angle_mode_force_disable">强制禁用（ForceDisable）</string>
    <string name="mg_angle_mode_force_enable">强制启用（ForceEnable）</string>

    <!-- 错误检查 -->
    <string name="mg_enable_noerror_title">错误检查</string>
    <string name="mg_enable_noerror_summary">降低或关闭 GL 错误检查，可减少部分游戏的 CPU 开销，但更难定位渲染错误。</string>
    <string name="mg_noerror_auto">自动（默认）</string>
    <string name="mg_noerror_disable">禁用错误检查</string>
    <string name="mg_noerror_level1">等级 1</string>
    <string name="mg_noerror_level2">等级 2</string>

    <!-- GL 版本 -->
    <string name="mg_custom_gl_version_title">向游戏报告的 GL 版本</string>
    <string name="mg_custom_gl_version_summary">0 表示 MobileGlues 默认的 4.0；34 到 39 会被 MobileGlues 夹取为 3.3，因此这里只列出有效档位。</string>
    <string name="mg_gl_version_default">默认（4.0）</string>
    <string name="mg_gl_version_value">%1$d.%2$d</string>

    <!-- FSR -->
    <string name="mg_fsr_title">FSR 1.0 超分辨率</string>
    <string name="mg_fsr_summary">使用 FSR 1.0 在较低渲染分辨率下上采样，档位越低性能越好、画质越差。</string>
    <string name="mg_fsr_disabled">关闭（默认）</string>
    <string name="mg_fsr_ultra_quality">超高质量</string>
    <string name="mg_fsr_quality">质量</string>
    <string name="mg_fsr_balanced">平衡</string>
    <string name="mg_fsr_performance">性能</string>

    <!-- ANGLE 深度清除修正 -->
    <string name="mg_depth_clear_title">ANGLE 深度清除修正</string>
    <string name="mg_depth_clear_summary">修正 ANGLE 后端下的深度缓冲清除异常；画面闪烁或深度错误时可尝试切换模式。</string>
    <string name="mg_depth_clear_disabled">关闭（默认）</string>
    <string name="mg_depth_clear_mode1">模式 1</string>
    <string name="mg_depth_clear_mode2">模式 2</string>

    <!-- 扩展 -->
    <string name="mg_ext_compute_title">EXT 计算着色器</string>
    <string name="mg_ext_compute_summary">暴露 GL_EXT_compute_shader 扩展，部分光影与模组需要。</string>
    <string name="mg_ext_timer_title">EXT 计时查询</string>
    <string name="mg_ext_timer_summary">暴露 GL_EXT_disjoint_timer_query，供性能统计类模组读取 GPU 耗时。</string>
    <string name="mg_ext_dsa_title">EXT 直接状态访问</string>
    <string name="mg_ext_dsa_summary">暴露 GL_EXT_direct_state_access，少数旧模组或渲染工具依赖。</string>
    <string name="mg_hide_env_title">隐藏 MG 环境变量（Level 1）</string>
    <string name="mg_hide_env_summary">隐藏 MobileGlues 注入的环境变量，个别整合包或模组会误读这些变量；一般无需开启。</string>
    <string name="mg_max_cache_title">GLSL 缓存上限</string>
    <string name="mg_max_cache_summary">缓存编译后的着色器以减少重复编译；0 表示不启用缓存，数值单位为 MB。</string>
    <string name="mg_unit_mb">MB</string>

    <!-- Multidraw -->
    <string name="mg_multidraw_order_title">Multidraw 全局顺序</string>
    <string name="mg_multidraw_order_summary">按顺序填写后端名称并用英文逗号分隔，可包含 native；该顺序会应用到未单独配置的入口。</string>
    <string name="mg_multidraw_order_label">multidrawOrder</string>
    <string name="mg_multidraw_order_error">不能为空，留空会导致 MobileGlues 无法确定顺序</string>
    <string name="mg_multidraw_entry_summary">可选，留空表示沿用全局顺序；后端名称用英文逗号分隔。</string>
    <string name="mg_multidraw_arrays_title">glMultiDrawArrays 顺序</string>
    <string name="mg_multidraw_elements_title">glMultiDrawElements 顺序</string>
    <string name="mg_multidraw_elements_base_vertex_title">glMultiDrawElementsBaseVertex 顺序</string>
    <string name="mg_multidraw_arrays_indirect_title">glMultiDrawArraysIndirect 顺序</string>
    <string name="mg_multidraw_elements_indirect_title">glMultiDrawElementsIndirect 顺序</string>

